{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/dashboard.mjs": { "maxDuration": 120 },
    "api/voc.mjs": { "maxDuration": 300 },
    "api/actions.mjs": { "maxDuration": 120 },
    "api/system.mjs": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/dashboard/config", "destination": "/api/dashboard?action=config" },
    { "source": "/api/dashboard/refresh", "destination": "/api/dashboard?action=refresh" },
    { "source": "/api/dashboard/current-nps", "destination": "/api/dashboard?action=current-nps" },
    { "source": "/api/voc-classify/health", "destination": "/api/voc?action=classify-health" },
    { "source": "/api/voc-classify", "destination": "/api/voc?action=classify" },
    { "source": "/api/voc-prepare", "destination": "/api/voc?action=prepare" },
    { "source": "/api/voc-manual-review", "destination": "/api/voc?action=review" },
    { "source": "/api/voc-sync/health", "destination": "/api/voc?action=sync-health" },
    { "source": "/api/voc-sync", "destination": "/api/voc?action=sync" },
    { "source": "/api/action-classify", "destination": "/api/actions?action=classify" },
    { "source": "/api/action-operational/plans", "destination": "/api/actions?action=plans" },
    { "source": "/api/system/logs", "destination": "/api/system?action=logs" },
    { "source": "/api/portal-audit/logs", "destination": "/api/system?action=portal-audit" }
  ],
  "headers": [
    {
      "source": "/js/(.*)\\.mjs",
      "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
    }
  ]
}
