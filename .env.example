# =============================================================================
# Variáveis usadas apenas no REFRESH server-side (npm run refresh:nps, scripts).
# Nunca commitar .env real. Nunca expor service_role no dashboard.
# =============================================================================

# BASE QV — READ ONLY (SELECT). project_ref documentado internamente.
BASE_QV_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# JWT service_role — necessário para SELECT em tabelas com RLS (ex.: clients).
BASE_QV_SUPABASE_SERVICE_ROLE_KEY=

# Opcional: reprocessar a partir de snapshot raw existente (sem novo SELECT)
# ANALYTICS_INGEST_SNAPSHOT=2026-09-28T20-55-21

# Bloqueado pelo código — não habilitar escrita em banco analítico
# ANALYTICS_ALLOW_DB_WRITES=1

# Opcional: Parquet quando writer estiver configurado (lib/data/file-store.mjs)
# ANALYTICS_USE_PARQUET=1

# Smoke / dev (opcional)
# PORT=5173
# SMOKE_PORT=5178
