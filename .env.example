# =========================================================
# BASE QV — SOMENTE LEITURA
# =========================================================

BASE_QV_SUPABASE_URL=https://lacinxsvjdwalkchxyeo.supabase.co
BASE_QV_SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_DA_BASE_QV


# =========================================================
# GEMINI — CLASSIFICAÇÃO DE VALÊNCIA VOC
# =========================================================

GEMINI_API_KEY=SUA_CHAVE_GEMINI

VOC_AI_PROVIDER=gemini
VOC_AI_MODEL=gemini-3.6-flash
VOC_USE_GEMINI=1

VOC_AI_CONCURRENCY=4
VOC_AI_RETRIES=3
VOC_AI_TIMEOUT_MS=28000


# =========================================================
# ANALYTICS NPS — BUSINESS DATA
# =========================================================

# modo de persistência atual
ANALYTICS_NPS_DB_MODE=postgres

# IMPORTANTE:
# aqui NÃO vai https://rckp...
# precisa ser a connection string PostgreSQL do Supabase:
# Dashboard > Connect > Connection string > Session pooler
ANALYTICS_NPS_DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORT/postgres


# =========================================================
# ANALYTICS NPS — SUPABASE / POSTGREST
# Mantemos configurado caso vocês voltem a usar a Data API
# =========================================================

ANALYTICS_NPS_SUPABASE_URL=https://rckpuebaiswrxzmywllv.supabase.co
ANALYTICS_NPS_SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_DO_RCKP


# =========================================================
# N8N / WORKER VOC
# preencher quando o endpoint do sync estiver publicado
# =========================================================

# POST https://<deploy>.vercel.app/api/voc-sync (n8n HTTP Request)
ANALYTICS_NPS_VOC_SYNC_URL=

# Authorization: Bearer <token> — somente backend/n8n (nunca dashboard)
ANALYTICS_NPS_VOC_SYNC_TOKEN=

# Timeout do handler HTTP (ms), default 540000
# VOC_SYNC_HTTP_TIMEOUT_MS=540000


# =========================================================
# OPCIONAL — fallback de modelo Gemini
# só use se o código do Cursor já implementou esse recurso
# =========================================================

# VOC_AI_FALLBACK_MODEL=gemini-3.5-flash